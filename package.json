{
  "name": "@dioxide-js/fetchx",
  "version": "1.0.0",
  "description": "A powerful and flexible TypeScript HTTP request library with retry, timeout, and interceptor support for both browser and Node.js",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "exports": {
    "import": "./lib/index.esm.js",
    "require": "./lib/index.cjs.js",
    "types": "./lib/index.d.ts"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose"
  },
  "keywords": [
    "fetch",
    "axios",
    "http",
    "request",
    "retry",
    "timeout",
    "interceptor",
    "proxy",
    "http-proxy",
    "typescript",
    "browser",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "https-proxy-agent": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "https-proxy-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^30.0.0",
    "axios": "^1.7.0",
    "https-proxy-agent": "^7.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "msw": "^2.11.6",
    "node-fetch": "^3.3.2",
    "rollup": "^4.20.0",
    "ts-jest": "^29.4.5",
    "tslib": "^2.6.0",
    "typescript": "^5.6.3"
  }
}
